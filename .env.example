# ─────────────────────────────────────────────────────────────────────────────
# Lynix Lab — environment variables
# Copy to .env for local development. In production, set these in
# Hostinger hPanel → your website → Environment variables (never commit .env).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Set it BEFORE the build that uses it (NEXT_PUBLIC_* values are baked in at build time).
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# PostgreSQL connection used by the app at runtime.
# With Neon/Supabase use the POOLED connection string here and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Max connections this app opens to Postgres (keep small on shared hosting / free DB tiers).
DATABASE_POOL_MAX="5"

# Secret used to sign session tokens. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=""

# Reverse-proxy handling for client IPs (rate limiting, audit log).
# Hostinger and most hosts sit behind one proxy → keep the defaults.
TRUST_PROXY="true"
TRUSTED_PROXY_HOPS="1"

# Optional: POST every new website lead to an automation webhook (n8n, Make, Zapier, Slack…).
LEAD_WEBHOOK_URL=""

# ── Only needed when running `npm run db:seed` (first admin user). Not needed at runtime. ──
ADMIN_EMAIL=""
ADMIN_PASSWORD=""   # min 12 characters
ADMIN_NAME="Admin"
